{
  "name": "vigie-civique-public",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "node scripts/verifier_markdown.mjs && vite build && node scripts/verifier_build.mjs",
